{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.vibe-coding/kit/src/worktrees/primary-write-guard-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking primary-checkout write guard..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.vibe-coding/kit/src/worktrees/hook-bypass-guard-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking git hook-bypass guard..."
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.vibe-coding/kit/src/orchestration/dispatch-guard-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking dispatch model guard..."
          }
        ]
      }
    ]
  }
}
