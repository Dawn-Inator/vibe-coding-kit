{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backend architecture source checks",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "services"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "language": { "enum": ["python", "typescript", "go"], "default": "python" },
    "services": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["root", "module"],
        "properties": { "root": { "type": "string", "minLength": 1 }, "module": { "type": "string", "minLength": 1 } }
      }
    },
    "scanRoots": { "$ref": "#/$defs/nonemptyPaths" },
    "providerRoots": { "$ref": "#/$defs/strings" },
    "providerModules": { "$ref": "#/$defs/strings" },
    "ormModules": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonemptyPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
